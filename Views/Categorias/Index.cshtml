    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    @model List<Categoria>

    <div class="categories-page">

        <section class="page-header">

            <div>

                <span class="eyebrow">
                    ADMINISTRACIÓN
                </span>

                <h1>
                    Gestión de categorías
                </h1>

                <p>
                    Administrá las categorías utilizadas para
                    organizar las clases de cocina de Sazón.
                </p>

            </div>


            <a class="btn-primary"
               asp-action="Create">
                + Nueva categoría
            </a>

        </section>


        <section class="categories-grid">

            @foreach (var categoria in Model)
            {
                <article class="category-card">

                    <div class="category-icon">
                        🍽️
                    </div>


                    <div class="category-content">

                        <h2>
                            @categoria.Nombre
                        </h2>

                        <p>
                            @categoria.Descripcion
                        </p>


                        @if (categoria.Activa)
                        {
                            <span class="status active">
                                ● Activa
                            </span>
                        }
                        else
                        {
                            <span class="status inactive">
                                ● Inactiva
                            </span>
                        }

                    </div>


                    <div class="category-actions">

                        <a class="btn-secondary"
                           asp-action="Edit"
                           asp-route-id="@categoria.Id">
                            Editar
                        </a>


                        @if (categoria.Activa)
                        {
                            <form asp-action="Delete"
                                  method="post"
                                  class="delete-form">

                                <input type="hidden"
                                       name="id"
                                       value="@categoria.Id" />

                                <button type="submit"
                                        class="btn-danger"
                                        onclick="return confirm('¿Querés desactivar esta categoría?');">
                                    Desactivar
                                </button>

                            </form>
                        }

                    </div>

                </article>
            }

        </section>

    </div>


}