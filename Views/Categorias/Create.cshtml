@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @model Categoria

    <div class="form-page">

        <div class="form-card">

            <div class="form-header">

                <span class="eyebrow">ADMINISTRACIÓN</span>

                <h1>Nueva categoría</h1>

                <p>
                    Creá una categoría para organizar las clases
                    de cocina de Sazón.
                </p>

            </div>


            <form asp-action="Create" method="post">

                <div class="form-group">

                    <label asp-for="Nombre"></label>

                    <input asp-for="Nombre"
                           class="form-input"
                           placeholder="Ej. Cocina Italiana" />

                    <span asp-validation-for="Nombre"
                          class="validation-message">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Descripcion"></label>

                    <textarea asp-for="Descripcion"
                              class="form-input textarea"
                              placeholder="Descripción de la categoría...">
                </textarea>

                    <span asp-validation-for="Descripcion"
                          class="validation-message">
                    </span>

                </div>


                <div class="checkbox-group">

                    <input asp-for="Activa" />

                    <label asp-for="Activa">
                        Categoría activa
                    </label>

                </div>


                <div class="form-actions">

                    <button type="submit"
                            class="btn-primary">
                        Guardar categoría
                    </button>

                    <a asp-action="Index"
                       class="btn-cancel">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
}
